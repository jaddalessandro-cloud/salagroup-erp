{
  "name": "salagroup-erp",
  "private": true,
  "version": "1.0.0",
  "description": "Sala Group — Sistema de información y gestión (Firebase)",
  "type": "module",
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "npm --prefix functions test",
